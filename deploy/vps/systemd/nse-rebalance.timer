[Unit]
Description=Run the NSE rebalance scan daily at 14:55 (weekdays, ~20min before F&O stocks' 15:15 continuous-trading cutoff -- also refreshes the Screener page's cache). Moved from 14:45 on 2026-08-04: real observed durations (Job Log page's rebalance_scan duration) run 130-410s (2-7min) typically, well under the ~13min figure this comment previously assumed -- that number came from a single historical outlier (2026-07-30, 780s), not the typical case. At 14:55, even that worst-case 780s run finishes ~15:08, still ~7min before the 15:15 cutoff; a typical run leaves 15-20min+. Re-check this duration history before ever moving the time later still -- it must finish with enough margin before 15:15 for auto_execute_trades (if enabled), or for you to manually execute, to place valid regular-hours orders. Still deliberately NOT pre-market: Kite's historical "day" candle for today updates live intraday, so running close to the cutoff gives the ranking/sizing pipeline a same-day price basis matching backtest.py's own same-day-close assumption, instead of pre-market's stale prior-day close (which also risked a gap-up open invalidating the day's sizing).

[Timer]
OnCalendar=Mon..Fri 14:55
# 2026-08-21: true, not false -- a VPS-provider-forced reboot right around
# today's 14:55 slot caused this timer to simply miss the day entirely
# (Persistent=false never catches up a missed occurrence, it just waits
# for the next scheduled one). live_rebalance.py's run_rebalance_scan()
# already no-ops on a non-trading day (nse_holidays.is_trading_day()), and
# an odd-hours catch-up attempt (e.g. the box coming back up before market
# open) would have any real order attempt rejected by Kite itself (market
# closed) rather than doing anything unsafe -- so catching up outweighs
# the small risk of an off-hours proposal-only run.
Persistent=true
Unit=nse-rebalance.service

[Install]
WantedBy=timers.target
