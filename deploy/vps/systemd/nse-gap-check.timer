[Unit]
Description=Run the gap-down safety check daily at 09:16 (weekdays, shortly after NSE's 09:15 open)

[Timer]
OnCalendar=Mon..Fri 09:16
# 2026-08-21: true -- see nse-rebalance.timer's comment. main_gap_check()
# already no-ops on a non-trading day, so a catch-up run outside its
# normal window is safe.
Persistent=true
Unit=nse-gap-check.service

[Install]
WantedBy=timers.target
