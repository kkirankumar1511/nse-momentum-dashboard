[Unit]
Description=Check the Kite login daily at 07:00 (weekdays) -- well after the ~6 AM token reset, well before the 09:16 gap-check and 09:15 market open, giving time to log in

[Timer]
OnCalendar=Mon..Fri 07:00
# 2026-08-21: true -- a missed check (e.g. box down over an unexpected
# reboot) should still catch up and notify if the token needs a login,
# rather than silently skip straight to the next scheduled day.
Persistent=true
Unit=nse-token-check.service

[Install]
WantedBy=timers.target
